<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> — Russell Marina API</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <main class="mx-auto max-w-4xl px-6 py-16">
      <a class="text-sm font-semibold text-cyan-300 hover:text-cyan-200" href="/catways">← Retour aux catways</a>

      <section class="mt-8 rounded-3xl border border-cyan-400/20 bg-slate-900 p-8 sm:p-10">
        <div class="flex flex-wrap items-start justify-between gap-5">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-400"><%= catway.catwayType %></p>
            <h1 class="mt-2 text-4xl font-bold">Catway #<%= catway.catwayNumber %></h1>
          </div>
          <a class="rounded-xl border border-slate-700 px-4 py-2 font-semibold text-slate-200 hover:bg-slate-800" href="/catways/<%= catway.catwayNumber %>/edit">
            Modifier l’état
          </a>
        </div>

        <% if (error) { %>
          <div class="mt-6 rounded-xl border border-red-400/30 bg-red-950/40 p-4 text-red-200" role="alert">
            <%= error %>
          </div>
        <% } %>

        <div class="mt-8 rounded-2xl bg-slate-950 p-6">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-400">État actuel</h2>
          <p class="mt-3 text-lg leading-8 text-slate-200"><%= catway.catwayState %></p>
        </div>

        <a class="mt-6 inline-flex rounded-xl border border-cyan-400/40 px-4 py-2 font-semibold text-cyan-300 hover:bg-cyan-950/30" href="/catways/<%= catway.catwayNumber %>/reservations">
          Voir les réservations de ce catway
        </a>

        <div class="mt-10 border-t border-slate-800 pt-8">
          <h2 class="font-bold text-red-300">Zone de suppression</h2>
          <p class="mt-2 text-sm text-slate-400">
            Un catway associé à une réservation ne peut pas être supprimé.
          </p>
          <form class="mt-4" action="/catways/<%= catway.catwayNumber %>?_method=DELETE" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button class="rounded-xl border border-red-400/40 px-4 py-2 font-semibold text-red-300 hover:bg-red-950/40" type="submit">
              Supprimer ce catway
            </button>
          </form>
        </div>
      </section>
    </main>
  </body>
</html>
