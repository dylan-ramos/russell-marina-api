<%- include("../partials/document-start", { pageTitle: ` — Russell Marina API` }) %>
    <%- include('../partials/navigation', { active: 'catways' }) %>
    <main class="mx-auto max-w-3xl px-6 py-16">
      <a class="text-sm font-semibold text-cyan-300 hover:text-cyan-200" href="/catways">← Retour aux catways</a>

      <section class="mt-8 rounded-3xl border border-cyan-400/20 bg-slate-900 p-8 shadow-xl sm:p-10">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-400">
          <%= mode === 'create' ? 'Nouveau catway' : 'État du catway' %>
        </p>
        <h1 class="mt-2 text-3xl font-bold"><%= title %></h1>

        <% if (errors.length > 0) { %>
          <div class="mt-6 rounded-xl border border-red-400/30 bg-red-950/40 p-4 text-red-200" role="alert">
            <ul class="list-disc space-y-1 pl-5">
              <% errors.forEach((error) => { %>
                <li><%= error %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <form
          class="mt-8 space-y-6"
          action="<%= mode === 'create' ? '/catways' : `/catways/${catway.catwayNumber}?_method=PUT` %>"
          method="post"
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label class="mb-2 block text-sm font-semibold" for="catwayNumber">Numéro</label>
              <input
                class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 disabled:cursor-not-allowed disabled:opacity-60"
                id="catwayNumber"
                name="catwayNumber"
                type="number"
                min="1"
                step="1"
                value="<%= catway.catwayNumber %>"
                <%= mode === 'edit' ? 'disabled' : 'required' %>
              />
            </div>

            <div>
              <label class="mb-2 block text-sm font-semibold" for="catwayType">Type</label>
              <select
                class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 disabled:cursor-not-allowed disabled:opacity-60"
                id="catwayType"
                name="catwayType"
                <%= mode === 'edit' ? 'disabled' : 'required' %>
              >
                <% catwayTypes.forEach((catwayType) => { %>
                  <option value="<%= catwayType %>" <%= catway.catwayType === catwayType ? 'selected' : '' %>>
                    <%= catwayType %>
                  </option>
                <% }) %>
              </select>
            </div>
          </div>

          <div>
            <label class="mb-2 block text-sm font-semibold" for="catwayState">Description de l’état</label>
            <textarea
              class="min-h-36 w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20"
              id="catwayState"
              name="catwayState"
              minlength="2"
              maxlength="500"
              required
            ><%= catway.catwayState %></textarea>
          </div>

          <div class="flex flex-wrap justify-end gap-3">
            <a class="rounded-xl border border-slate-700 px-5 py-3 font-semibold text-slate-300 hover:bg-slate-800" href="/catways">
              Annuler
            </a>
            <button class="rounded-xl bg-cyan-400 px-5 py-3 font-bold text-slate-950 hover:bg-cyan-300" type="submit">
              <%= mode === 'create' ? 'Créer le catway' : 'Enregistrer l’état' %>
            </button>
          </div>
        </form>
      </section>
    </main>
<%- include("../partials/document-end") %>
