<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> — Russell Marina API</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <header class="border-b border-slate-800 bg-slate-900">
      <nav class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-4" aria-label="Navigation principale">
        <a class="text-lg font-bold text-cyan-300" href="/dashboard">Russell Marina</a>
        <div class="flex items-center gap-3">
          <a class="rounded-lg px-3 py-2 text-sm text-slate-300 hover:bg-slate-800 hover:text-white" href="/catways">
            Catways
          </a>
          <a class="rounded-lg px-3 py-2 text-sm text-slate-300 hover:bg-slate-800 hover:text-white" href="/reservations">
            Réservations
          </a>
          <a class="rounded-lg px-3 py-2 text-sm text-slate-300 hover:bg-slate-800 hover:text-white" href="/api-docs">
            Documentation
          </a>
          <a class="rounded-lg border border-red-400/30 px-3 py-2 text-sm text-red-300 hover:bg-red-950/40" href="/logout">
            Déconnexion
          </a>
        </div>
      </nav>
    </header>

    <main class="mx-auto max-w-6xl px-6 py-12">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-400"><%= today %></p>
      <h1 class="mt-3 text-4xl font-bold"><%= title %></h1>

      <section class="mt-10 rounded-2xl border border-slate-800 bg-slate-900 p-6">
        <h2 class="text-lg font-semibold">Utilisateur connecté</h2>
        <dl class="mt-5 grid gap-5 sm:grid-cols-2">
          <div>
            <dt class="text-sm text-slate-400">Nom d’utilisateur</dt>
            <dd class="mt-1 font-semibold"><%= currentUser.username %></dd>
          </div>
          <div>
            <dt class="text-sm text-slate-400">Adresse email</dt>
            <dd class="mt-1 font-semibold"><%= currentUser.email %></dd>
          </div>
        </dl>
      </section>

      <section class="mt-8 rounded-2xl border border-dashed border-slate-700 p-8 text-center text-slate-400">
        Les réservations en cours seront ajoutées lors de l’étape tableau de bord.
      </section>
    </main>
  </body>
</html>
