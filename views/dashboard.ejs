<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> — Russell Marina API</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <%- include('partials/navigation', { active: 'dashboard' }) %>

    <main class="mx-auto max-w-6xl px-6 py-12">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-400"><%= today %></p>
      <h1 class="mt-3 text-4xl font-bold"><%= title %></h1>
      <p class="mt-3 text-slate-400">Bienvenue, <%= currentUser.username %>.</p>

      <section class="mt-10 grid gap-4 sm:grid-cols-3" aria-label="Statistiques du port">
        <a class="rounded-2xl border border-slate-800 bg-slate-900 p-6 hover:border-cyan-400/40" href="/catways">
          <p class="text-sm text-slate-400">Catways</p><p class="mt-2 text-3xl font-bold text-cyan-300"><%= statistics.catwayCount %></p>
        </a>
        <a class="rounded-2xl border border-slate-800 bg-slate-900 p-6 hover:border-cyan-400/40" href="/reservations">
          <p class="text-sm text-slate-400">Réservations</p><p class="mt-2 text-3xl font-bold text-cyan-300"><%= statistics.reservationCount %></p>
        </a>
        <a class="rounded-2xl border border-slate-800 bg-slate-900 p-6 hover:border-cyan-400/40" href="/users">
          <p class="text-sm text-slate-400">Utilisateurs</p><p class="mt-2 text-3xl font-bold text-cyan-300"><%= statistics.userCount %></p>
        </a>
      </section>

      <section class="mt-8 rounded-2xl border border-slate-800 bg-slate-900 p-6">
        <h2 class="text-lg font-semibold">Utilisateur connecté</h2>
        <dl class="mt-5 grid gap-5 sm:grid-cols-2">
          <div><dt class="text-sm text-slate-400">Nom d’utilisateur</dt><dd class="mt-1 font-semibold"><%= currentUser.username %></dd></div>
          <div><dt class="text-sm text-slate-400">Adresse email</dt><dd class="mt-1 font-semibold"><%= currentUser.email %></dd></div>
        </dl>
      </section>

      <section class="mt-8" aria-labelledby="current-reservations-title">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <h2 class="text-2xl font-bold" id="current-reservations-title">Réservations en cours</h2>
            <p class="mt-2 text-slate-400"><%= currentReservations.length %> bateau(x) actuellement au port</p>
          </div>
          <a class="font-semibold text-cyan-300 hover:text-cyan-200" href="/reservations">Toutes les réservations →</a>
        </div>

        <% if (currentReservations.length === 0) { %>
          <div class="mt-6 rounded-2xl border border-dashed border-slate-700 p-8 text-center text-slate-400">Aucune réservation n’est en cours aujourd’hui.</div>
        <% } else { %>
          <div class="mt-6 overflow-hidden rounded-2xl border border-slate-800 bg-slate-900">
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-slate-800">
                <thead class="text-left text-xs uppercase tracking-wider text-slate-400"><tr><th class="px-6 py-4">Catway</th><th class="px-6 py-4">Client</th><th class="px-6 py-4">Bateau</th><th class="px-6 py-4">Période</th><th class="px-6 py-4 text-right">Action</th></tr></thead>
                <tbody class="divide-y divide-slate-800">
                  <% currentReservations.forEach((reservation) => { %>
                    <tr>
                      <td class="px-6 py-4 font-bold text-cyan-300">#<%= reservation.catwayNumber %></td>
                      <td class="px-6 py-4"><%= reservation.clientName %></td>
                      <td class="px-6 py-4 text-slate-300"><%= reservation.boatName %></td>
                      <td class="whitespace-nowrap px-6 py-4 text-sm text-slate-300"><%= dateFormatter.format(reservation.startDate) %> – <%= dateFormatter.format(reservation.endDate) %></td>
                      <td class="px-6 py-4 text-right"><a class="font-semibold text-cyan-300 hover:text-cyan-200" href="/catways/<%= reservation.catwayNumber %>/reservations/<%= reservation.id %>">Détails</a></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        <% } %>
      </section>
    </main>
  </body>
</html>
