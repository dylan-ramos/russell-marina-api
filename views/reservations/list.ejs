<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> — Russell Marina API</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <%- include('../partials/navigation', { active: 'reservations' }) %>

    <main class="mx-auto max-w-7xl px-6 py-12">
      <div class="flex flex-wrap items-end justify-between gap-5">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-400">Planning du port</p>
          <h1 class="mt-2 text-4xl font-bold"><%= title %></h1>
          <p class="mt-2 text-slate-400"><%= reservations.length %> réservation(s)</p>
        </div>
        <a
          class="rounded-xl bg-cyan-400 px-5 py-3 font-bold text-slate-950 hover:bg-cyan-300"
          href="<%= selectedCatwayNumber ? `/catways/${selectedCatwayNumber}/reservations/new` : '/reservations/new' %>"
        >
          Ajouter une réservation
        </a>
      </div>

      <% if (notification) { %>
        <div class="mt-8 rounded-xl border border-emerald-400/30 bg-emerald-950/40 p-4 text-emerald-200" role="status">
          <%= notification %>
        </div>
      <% } %>

      <div class="mt-8 overflow-hidden rounded-2xl border border-slate-800 bg-slate-900">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-slate-800">
            <thead class="text-left text-xs uppercase tracking-wider text-slate-400">
              <tr>
                <th class="px-5 py-4" scope="col">Catway</th>
                <th class="px-5 py-4" scope="col">Client</th>
                <th class="px-5 py-4" scope="col">Bateau</th>
                <th class="px-5 py-4" scope="col">Début</th>
                <th class="px-5 py-4" scope="col">Fin</th>
                <th class="px-5 py-4 text-right" scope="col">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800">
              <% reservations.forEach((reservation) => { %>
                <tr class="hover:bg-slate-800/40">
                  <td class="px-5 py-4 font-bold text-cyan-300">#<%= reservation.catwayNumber %></td>
                  <td class="px-5 py-4"><%= reservation.clientName %></td>
                  <td class="px-5 py-4 text-slate-300"><%= reservation.boatName %></td>
                  <td class="whitespace-nowrap px-5 py-4 text-slate-300"><%= reservation.startDate.toLocaleDateString('fr-FR') %></td>
                  <td class="whitespace-nowrap px-5 py-4 text-slate-300"><%= reservation.endDate.toLocaleDateString('fr-FR') %></td>
                  <td class="whitespace-nowrap px-5 py-4 text-right">
                    <a class="font-semibold text-cyan-300 hover:text-cyan-200" href="/catways/<%= reservation.catwayNumber %>/reservations/<%= reservation.id %>">Détails</a>
                    <a class="ml-4 font-semibold text-slate-300 hover:text-white" href="/catways/<%= reservation.catwayNumber %>/reservations/<%= reservation.id %>/edit">Modifier</a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </body>
</html>
