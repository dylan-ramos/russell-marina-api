<%- include("../partials/document-start", { pageTitle: ` — Russell Marina API` }) %>
    <%- include('../partials/navigation', { active: 'reservations' }) %>
    <main class="mx-auto max-w-4xl px-6 py-16">
      <a class="text-sm font-semibold text-cyan-300 hover:text-cyan-200" href="/reservations">← Retour aux réservations</a>

      <section class="mt-8 rounded-3xl border border-cyan-400/20 bg-slate-900 p-8 sm:p-10">
        <div class="flex flex-wrap items-start justify-between gap-5">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-400">Catway #<%= reservation.catwayNumber %></p>
            <h1 class="mt-2 text-4xl font-bold"><%= reservation.boatName %></h1>
            <p class="mt-2 text-slate-400">Réservé par <%= reservation.clientName %></p>
          </div>
          <a class="rounded-xl border border-slate-700 px-4 py-2 font-semibold" href="/catways/<%= reservation.catwayNumber %>/reservations/<%= reservation.id %>/edit">Modifier</a>
        </div>

        <dl class="mt-8 grid gap-6 rounded-2xl bg-slate-950 p-6 sm:grid-cols-2">
          <div>
            <dt class="text-sm text-slate-400">Date de début</dt>
            <dd class="mt-1 text-lg font-semibold"><%= reservation.startDate.toLocaleDateString('fr-FR') %></dd>
          </div>
          <div>
            <dt class="text-sm text-slate-400">Date de fin</dt>
            <dd class="mt-1 text-lg font-semibold"><%= reservation.endDate.toLocaleDateString('fr-FR') %></dd>
          </div>
        </dl>

        <div class="mt-10 border-t border-slate-800 pt-8">
          <form action="/catways/<%= reservation.catwayNumber %>/reservations/<%= reservation.id %>?_method=DELETE" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button class="rounded-xl border border-red-400/40 px-4 py-2 font-semibold text-red-300 hover:bg-red-950/40" type="submit">
              Supprimer cette réservation
            </button>
          </form>
        </div>
      </section>
    </main>
<%- include("../partials/document-end") %>
