<%- include("partials/document-start", { pageTitle: `Erreur  — Russell Marina API` }) %>
    <main class="mx-auto flex min-h-screen max-w-3xl items-center px-6 py-16">
      <section class="w-full rounded-3xl border border-red-400/20 bg-slate-900 p-8 sm:p-12">
        <p class="text-sm font-semibold uppercase tracking-[0.25em] text-red-400">Erreur <%= status %></p>
        <h1 class="mt-3 text-3xl font-bold">
          <%= status === 403 ? 'Accès refusé' : status === 404 ? 'Page introuvable' : status >= 500 ? 'Erreur interne' : 'La demande a échoué' %>
        </h1>
        <p class="mt-4 leading-7 text-slate-300"><%= message %></p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="rounded-xl bg-cyan-400 px-5 py-3 font-bold text-slate-950 hover:bg-cyan-300" href="/">Retour à l’accueil</a>
        </div>
        <% if (error.stack) { %>
          <details class="mt-8"><summary class="cursor-pointer text-sm text-slate-400">Détails techniques</summary><pre class="mt-3 overflow-auto rounded-xl bg-slate-950 p-4 text-sm text-slate-300"><%= error.stack %></pre></details>
        <% } %>
      </section>
    </main>
<%- include("partials/document-end") %>
