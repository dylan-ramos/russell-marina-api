<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Erreur <%= error.status || 500 %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <main class="mx-auto flex min-h-screen max-w-3xl items-center px-6 py-16">
      <section class="w-full rounded-3xl border border-red-400/20 bg-slate-900 p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.25em] text-red-400">
          Erreur <%= error.status || 500 %>
        </p>
        <h1 class="mt-3 text-3xl font-bold"><%= message %></h1>
        <% if (error.stack) { %>
          <pre class="mt-8 overflow-auto rounded-xl bg-slate-950 p-4 text-sm text-slate-300"><%= error.stack %></pre>
        <% } %>
      </section>
    </main>
  </body>
</html>
