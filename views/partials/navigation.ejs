<header class="border-b border-slate-800 bg-slate-900">
  <nav
    class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-4"
    aria-label="Navigation principale"
  >
    <a class="text-lg font-bold text-cyan-300" href="/dashboard">Russell Marina</a>
    <div class="flex flex-wrap items-center gap-2">
      <% const links = [
        { key: 'catways', label: 'Catways', href: '/catways' },
        { key: 'reservations', label: 'Réservations', href: '/reservations' },
        { key: 'users', label: 'Utilisateurs', href: '/users' },
        { key: 'documentation', label: 'Documentation', href: '/api-docs' },
      ]; %>
      <% links.forEach((link) => { %>
        <a
          class="rounded-lg px-3 py-2 text-sm <%= active === link.key ? 'bg-slate-800 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>"
          href="<%= link.href %>"
          <%- active === link.key ? 'aria-current="page"' : '' %>
        ><%= link.label %></a>
      <% }) %>
      <form action="/logout" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button
          class="rounded-lg border border-red-400/30 px-3 py-2 text-sm text-red-300 hover:bg-red-950/40"
          type="submit"
        >Déconnexion</button>
      </form>
    </div>
  </nav>
</header>
