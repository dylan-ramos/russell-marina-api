# Configuration d'exemple versionnée. Ne placer aucun secret réel ici.
COMPOSE_PROJECT_NAME=russell-marina-api
APP_PORT=3000
PORT=3000

MONGO_DATABASE=russell_marina
MONGO_ROOT_USERNAME=russell_example
MONGO_ROOT_PASSWORD=replace-with-a-secure-password
MONGO_APP_USERNAME=russell_app_example
MONGO_APP_PASSWORD=replace-with-another-secure-password

SESSION_SECRET=replace-with-a-long-random-secret
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=replace-with-a-secure-password

TRAEFIK_HOST=russell-marina-api.srv924756.hstgr.cloud
TRAEFIK_CERT_RESOLVER=lehttp
