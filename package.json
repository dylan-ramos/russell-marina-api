{
  "name": "russell-marina-api",
  "version": "0.1.0",
  "description": "API et interface de gestion du port de plaisance Russell",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others -n server,css -c blue,cyan \"npm:dev:server\" \"npm:css:watch\"",
    "dev:server": "tsx watch src/bin/www.ts",
    "build": "npm run typecheck && npm run css:build && tsc",
    "start": "node dist/bin/www.js",
    "test": "node --test",
    "seed": "node dist/scripts/seed.js",
    "seed:dev": "tsx src/scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "css:build": "npx @tailwindcss/cli -i ./src/styles/input.css -o ./public/stylesheets/style.css",
    "css:watch": "npx @tailwindcss/cli -i ./src/styles/input.css -o ./public/stylesheets/style.css --watch"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "debug": "^4.4.3",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.1",
    "mongoose": "^9.9.2",
    "morgan": "^1.11.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/debug": "^4.1.13",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/http-errors": "^2.0.5",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.4",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
